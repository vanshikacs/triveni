# ---- Frontend (Vite) ----
# Optional. Base URL of the extraction backend. Leave empty to use only the in-browser demo pipeline.
# In local dev, "/api" is proxied to http://127.0.0.1:8000 by vite.config.ts.
VITE_TRIVENI_API=

# ---- Backend (server/main.py) ----
# Optional. Without a key the backend returns 503 and the frontend falls back to the demo pipeline.
# Never commit a real key. Never put it in a VITE_ variable (those are shipped to the browser).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
